# LLM (OpenRouter)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna
LLM_FALLBACK_MODEL=openai/gpt-6-luna
LLM_TIMEOUT_SECONDS=60

# Email (Gmail SMTP)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_OWNER_EMAIL=

# Reports and scheduler
REPORT_MODE=dry_run
TIMEZONE=Europe/London
DATA_END_DATE=2026-09-30
REPORT_RETRY_DELAY_SECONDS=300